
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Function to get user roles from the 'roles' collection.
    function getRoles() {
      // access a document in the 'roles' collection where the doc ID is the user's UID.
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }

    // Coordonnées du profil: types et longueurs bornés (nom, téléphone, adresse).
    function validProfile(d) {
      return (!('name' in d) || (d.name is string && d.name.size() <= 100))
          && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
          && (!('address' in d) || (d.address is string && d.address.size() <= 500));
    }

    function isAdmin() {
      // Check for the 'admin' field in the user's role document.
      return getRoles().get('admin', false) == true;
    }

    function isProductManager() {
      // Check for the 'productManager' field in the user's role document.
      return getRoles().get('productManager', false) == true;
    }
    function isOrderManager() {
      // Check for the 'orderManager' field in the user's role document.
      return getRoles().get('orderManager', false) == true;
    }

    // ROLES COLLECTION
    // This collection stores user roles. Only admins can modify it.
    match /roles/{userId} {
      allow read, write: if isAdmin();
    }

    // PUBLIC COLLECTIONS
    match /shoes/{shoeId} {
      allow get, list: if true;
      allow write: if isAdmin() || isProductManager(); // Admins or Product Managers can write.
    }
    
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin(); // Only admins can write.
    }

    match /collections/{collectionId} {
      allow get, list: if true;
      allow write: if isAdmin(); // Only admins can write.
    }
    
    // Les codes promo ne sont plus lisibles publiquement: la validation passe par
    // la Server Action validatePromoCode (Admin SDK, avec limite de débit).
    match /promoCodes/{promoId} {
      allow read, write: if isAdmin();
    }

    // USER-SPECIFIC COLLECTIONS
    // Un utilisateur ne peut jamais s'attribuer de rôle via son propre profil.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && !request.resource.data.keys().hasAny(['role', 'admin', 'roles']) && validProfile(request.resource.data);
      allow update: if (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'roles'])
                        && validProfile(request.resource.data))
                    || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    match /users/{userId}/preferences/{preferenceId} {
      allow read, write: if isOwner(userId);
    }

    // ORDERS
    match /orders/{orderId} {
      // Création uniquement via la Server Action createOrder (prix, remise, statut
      // et code de livraison calculés côté serveur). Aucune création côté client.
      allow create: if false;
      // An order can be read by its owner, an admin, or an order manager.
      allow read: if (resource.data.userId == request.auth.uid) || isAdmin() || isOrderManager(); 
      // Order status can be updated by an admin or order manager.
      allow update, delete: if isAdmin() || isOrderManager();
      // All orders can be listed by an admin or order manager.
      allow list: if isAdmin() || isOrderManager();
    }
  }
}
